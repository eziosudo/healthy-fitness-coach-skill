# syntax=docker/dockerfile:1
FROM node:22-alpine
WORKDIR /app/mcp/xunji
COPY healthy-fitness-coach-plugin/mcp/xunji/package.json healthy-fitness-coach-plugin/mcp/xunji/package-lock.json ./
RUN --mount=type=cache,id=healthy-fitness-npm,target=/root/.npm npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY healthy-fitness-coach-plugin/mcp/xunji/src/ ./src/
COPY healthy-fitness-coach-plugin/skills/ /app/skills/
COPY LICENSE /app/LICENSE
RUN mkdir -p /app/data && chown node:node /app/data
USER node
ENV PORT=8080 LOCALAPPDATA=/app/data TZ=Asia/Shanghai
EXPOSE 8080
CMD ["node", "src/http-server.js"]
